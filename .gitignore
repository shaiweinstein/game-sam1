# macOS junk
.DS_Store
._*

# Kilo: local UI/recovery state (not source)
.kilo/agent-manager.json

# Playwright MCP screenshot/output artifacts
.playwright-mcp/

# Python bytecode (Blender build scripts)
__pycache__/

# Logs / temp
*.log
tmp/

# Local credential files — NEVER commit
*-login.md

# Public bundle built by make_deploy.py (never commit)
deploy/

# Adobe Mixamo raw source files — Adobe's terms forbid redistributing these;
# they are dev-only inputs for the retargeted clips in beach3d/assets/*.glb.
spike3/assets/mixamo/

# IDE/MCP config — may contain secrets; configure via env vars (BRAVE_API_KEY)
.kilo/kilo.json
